@model FacultyEvalSystem.ViewModels.FacultyDashboardViewModel
@{ ViewData["Title"] = "My Evaluation Dashboard"; }

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <p class="mb-1">SET Rating (Student)</p>
            <h3>@(Model.LatestResult?.StudentRating.ToString("F2") ?? "N/A")</h3>
            @if (Model.LatestResult is not null && !string.IsNullOrEmpty(Model.LatestResult.StudentDescriptiveRating))
            {
                <span class="badge bg-secondary">
                    @Model.LatestResult.StudentDescriptiveRating
                </span>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card" style="border-left-color:#f0b429;">
            <p class="mb-1">SEF Rating (Supervisor)</p>
            <h3>@(Model.LatestResult?.SupervisorRating.ToString("F2") ?? "N/A")</h3>
            @if (Model.LatestResult is not null && !string.IsNullOrEmpty(Model.LatestResult.SupervisorDescriptiveRating))
            {
                <span class="badge bg-secondary">
                    @Model.LatestResult.SupervisorDescriptiveRating
                </span>
            }
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Category Breakdown (Student Evaluation)</div>
            <div class="card-body">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Performance History</div>
            <div class="card-body">
                <canvas id="historyChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Evaluation History</div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Semester</th><th>SET Rating</th><th>SET Description</th><th>SEF Rating</th><th>SEF Description</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.History)
                {
                    <tr>
                        <td>@r.EvaluationPeriod.Semester.DisplayName</td>
                        <td><strong>@r.StudentRating.ToString("F2")</strong></td>
                        <td><span class="badge bg-secondary">@r.StudentDescriptiveRating</span></td>
                        <td><strong>@r.SupervisorRating.ToString("F2")</strong></td>
                        <td><span class="badge bg-secondary">@r.SupervisorDescriptiveRating</span></td>
                    </tr>
                }
                @if (!Model.History.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No evaluation results yet</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    var categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown.Keys));
    var ratings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown.Values));

    if (categories.length > 0) {
        new Chart(document.getElementById('categoryChart'), {
            type: 'radar',
            data: {
                labels: categories,
                datasets: [{
                    label: 'Rating (1-5)',
                    data: ratings,
                    borderColor: '#1a5632',
                    backgroundColor: 'rgba(26,86,50,0.2)',
                    pointBackgroundColor: '#1a5632'
                }]
            },
            options: {
                responsive: true,
                scales: { r: { beginAtZero: true, max: 5 } }
            }
        });
    }

    var historyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.History.AsEnumerable().Reverse().Select(h => h.EvaluationPeriod.Semester.DisplayName).ToArray()));
    var historyRatings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.History.AsEnumerable().Reverse().Select(h => h.StudentRating).ToArray()));

    if (historyLabels.length > 0) {
        new Chart(document.getElementById('historyChart'), {
            type: 'line',
            data: {
                labels: historyLabels,
                datasets: [{
                    label: 'SET Rating',
                    data: historyRatings,
                    borderColor: '#1a5632',
                    backgroundColor: 'rgba(26,86,50,0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, max: 100 } }
            }
        });
    }
</script>
}
