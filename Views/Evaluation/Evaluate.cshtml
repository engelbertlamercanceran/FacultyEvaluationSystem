@model FacultyEvalSystem.ViewModels.EvaluationFormViewModel
@{ ViewData["Title"] = "Evaluate Faculty"; }

<style>
    .criteria-card input[type="radio"].form-check-input {
        width: 1.4em;
        height: 1.4em;
        cursor: pointer;
        border: 2px solid #adb5bd;
    }
    .criteria-card input[type="radio"].form-check-input:checked {
        border-color: #1a5632;
        background-color: #1a5632;
    }
    tr.unanswered td {
        background-color: #fff3cd !important;
    }
</style>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="mb-1">@Model.FacultyName</h5>
        @if (Model.SubjectName is not null)
        {
            <p class="text-muted mb-0">@Model.SubjectName</p>
        }
    </div>
</div>

<form asp-action="Evaluate" method="post" id="evalForm">
    <input type="hidden" asp-for="EvaluationPeriodId" />
    <input type="hidden" asp-for="FacultyId" />
    <input type="hidden" asp-for="FacultySubjectId" />
    <input type="hidden" asp-for="EvaluatorType" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    @for (int c = 0; c < Model.Categories.Count; c++)
    {
        var category = Model.Categories[c];
        <div class="card mb-3 criteria-card">
            <div class="card-header">
                <strong>@category.CategoryName</strong>
            </div>
            <div class="card-body p-0">
                <input type="hidden" name="Categories[@c].CategoryId" value="@category.CategoryId" />
                <input type="hidden" name="Categories[@c].CategoryName" value="@category.CategoryName" />
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="width:40%">Benchmark Statements</th>
                            <th class="text-center">5<br/><small>Always Manifested</small></th>
                            <th class="text-center">4<br/><small>Often Manifested</small></th>
                            <th class="text-center">3<br/><small>Sometimes Manifested</small></th>
                            <th class="text-center">2<br/><small>Seldom Manifested</small></th>
                            <th class="text-center">1<br/><small>Never/Rarely Manifested</small></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < category.Criteria.Count; i++)
                        {
                            var criterion = category.Criteria[i];
                            <tr>
                                <td>
                                    @criterion.Description
                                    <input type="hidden" name="Categories[@c].Criteria[@i].CriterionId" value="@criterion.CriterionId" />
                                    <input type="hidden" name="Categories[@c].Criteria[@i].Description" value="@criterion.Description" />
                                </td>
                                @for (int r = 5; r >= 1; r--)
                                {
                                    <td class="text-center">
                                        <input type="radio"
                                               name="Categories[@c].Criteria[@i].Rating"
                                               value="@r"
                                               class="form-check-input"
                                               required />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header"><strong>Comments (Optional)</strong></div>
        <div class="card-body">
            <textarea asp-for="Comments" class="form-control" rows="3" placeholder="Additional comments or suggestions..."></textarea>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="button" class="btn btn-primary px-4" id="btnSubmit">
            Submit Evaluation
        </button>
    </div>
</form>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Evaluation Submission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>You are about to submit your evaluation for <strong>@Model.FacultyName</strong>.</p>
                <div class="card bg-light mb-3">
                    <div class="card-body text-center">
                        <p class="mb-1 text-muted">Your Computed Rating</p>
                        <h2 id="computedRating" style="color:#1a5632;">—</h2>
                        <span id="computedDesc" class="badge"></span>
                    </div>
                </div>
                <div id="categoryBreakdown" class="mb-3"></div>
                <p class="text-muted small mb-2">Formula: (Total Score / 75) &times; 100</p>
                <p class="text-danger small mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Go Back</button>
                <button type="button" class="btn btn-primary" id="btnConfirmSubmit">Confirm & Submit</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('btnSubmit').addEventListener('click', function () {
        var form = document.getElementById('evalForm');

        // Check all radios are selected and highlight unanswered
        var allRadioGroups = {};
        form.querySelectorAll('input[type="radio"]').forEach(function (r) {
            if (!allRadioGroups[r.name]) allRadioGroups[r.name] = { answered: false, row: r.closest('tr') };
            if (r.checked) allRadioGroups[r.name].answered = true;
        });

        // Clear previous highlights
        form.querySelectorAll('tr.unanswered').forEach(function (row) { row.classList.remove('unanswered'); });

        var unanswered = Object.values(allRadioGroups).filter(function (g) { return !g.answered; });
        if (unanswered.length > 0) {
            unanswered.forEach(function (g) { g.row.classList.add('unanswered'); });
            unanswered[0].row.scrollIntoView({ behavior: 'smooth', block: 'center' });
            alert('Please provide a rating for all criteria. ' + unanswered.length + ' item(s) remaining.');
            return;
        }

        // Compute per-category averages and overall percentage rating
        // Formula per CMO: Rating = (Total Score / 75) × 100
        var categories = document.querySelectorAll('.criteria-card');
        var breakdownHtml = '<table class="table table-sm mb-0"><thead><tr><th>Category</th><th class="text-center">Average (1-5)</th></tr></thead><tbody>';
        var totalScore = 0;

        categories.forEach(function (card) {
            var header = card.querySelector('.card-header strong');
            if (!header) return;
            var catName = header.textContent;
            var radios = card.querySelectorAll('input[type="radio"]:checked');
            if (radios.length === 0) return;

            var sum = 0;
            radios.forEach(function (r) { sum += parseInt(r.value); });
            var avg = sum / radios.length;
            totalScore += sum;

            breakdownHtml += '<tr><td>' + catName + '</td><td class="text-center"><strong>' + avg.toFixed(2) + '</strong></td></tr>';
        });

        breakdownHtml += '</tbody></table>';
        var rating = (totalScore / 75) * 100;

        document.getElementById('computedRating').textContent = rating.toFixed(2) + '%';
        document.getElementById('categoryBreakdown').innerHTML = breakdownHtml;

        // Descriptive rating per CMO rating scale operational definitions
        var desc = rating >= 91 ? 'Always Manifested' : rating >= 61 ? 'Often Manifested' : rating >= 31 ? 'Sometimes Manifested' : rating >= 11 ? 'Seldom Manifested' : 'Never/Rarely Manifested';
        var descEl = document.getElementById('computedDesc');
        descEl.textContent = desc;
        descEl.className = 'badge bg-success';

        var modal = new bootstrap.Modal(document.getElementById('confirmModal'));
        modal.show();
    });

    document.getElementById('btnConfirmSubmit').addEventListener('click', function () {
        document.getElementById('evalForm').submit();
    });
</script>
}
