@model FacultyEvalSystem.ViewModels.EvaluationListViewModel
@{ ViewData["Title"] = "Faculty Evaluation"; }

@if (Model.ActivePeriod is null)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h5 class="text-muted">No Active Evaluation Period</h5>
            <p class="text-muted">The evaluation period is currently closed. Please check back later.</p>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <strong>@Model.ActivePeriod.Name</strong> - @Model.ActivePeriod.Semester.DisplayName<br/>
        <small>Open from @Model.ActivePeriod.StartDate.ToString("MMMM dd") to @Model.ActivePeriod.EndDate.ToString("MMMM dd, yyyy")</small>
    </div>

    <div class="card">
        <div class="card-header">Faculty to Evaluate</div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Faculty Name</th>
                        <th>Subject</th>
                        <th>Section</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.FacultyList)
                    {
                        <tr>
                            <td>@f.FacultyName</td>
                            <td>@(f.SubjectCode is not null ? $"{f.SubjectCode} - {f.SubjectName}" : "General")</td>
                            <td>@(f.Section ?? "-")</td>
                            <td>
                                @if (f.AlreadyEvaluated)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @if (!f.AlreadyEvaluated)
                                {
                                    <a asp-action="Evaluate"
                                       asp-route-facultyId="@f.FacultyId"
                                       asp-route-periodId="@Model.ActivePeriod.Id"
                                       asp-route-subjectId="@f.FacultySubjectId"
                                       class="btn btn-primary btn-sm">Evaluate</a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm btn-view-rating" data-eval-id="@f.EvaluationId">View My Rating</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.FacultyList.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No faculty assigned for evaluation</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- My Rating Modal -->
    <div class="modal fade" id="ratingModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">My Evaluation Rating</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6 id="ratingFacultyName" class="mb-3"></h6>
                    <div class="card bg-light mb-3">
                        <div class="card-body text-center">
                            <p class="mb-1 text-muted">Overall Rating</p>
                            <h2 id="ratingOverall" style="color:#1a5632;">—</h2>
                            <span id="ratingDesc" class="badge"></span>
                        </div>
                    </div>
                    <div id="ratingBreakdown"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    document.querySelectorAll('.btn-view-rating').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var evalId = this.getAttribute('data-eval-id');
            fetch('@Url.Action("MyRating")' + '?evaluationId=' + evalId)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    document.getElementById('ratingFacultyName').textContent = data.facultyName;
                    document.getElementById('ratingOverall').textContent = data.overall.toFixed(2);

                    var descEl = document.getElementById('ratingDesc');
                    descEl.textContent = data.description;
                    descEl.className = 'badge badge-' + data.description.toLowerCase().replace(' ', '-');

                    var html = '<table class="table table-sm mb-0"><thead><tr><th>Category</th><th class="text-center">Average</th></tr></thead><tbody>';
                    data.categories.forEach(function (c) {
                        html += '<tr><td>' + c.name + '</td><td class="text-center"><strong>' + c.average.toFixed(2) + '</strong></td></tr>';
                    });
                    html += '</tbody></table>';
                    document.getElementById('ratingBreakdown').innerHTML = html;

                    var modal = new bootstrap.Modal(document.getElementById('ratingModal'));
                    modal.show();
                });
        });
    });
</script>
}
