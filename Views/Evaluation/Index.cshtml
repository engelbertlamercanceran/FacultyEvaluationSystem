@using FacultyEvalSystem.ViewModels
@model EvaluationListViewModel
@{
    ViewData["Title"] = "Faculty Evaluation";
    var isStudent = User.IsInRole("Student");
}

@if (Model.ActivePeriod is null)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h5 class="text-muted">No Active Evaluation Period</h5>
            <p class="text-muted">There is no evaluation open at the moment. Please check back later.</p>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <strong>@Model.ActivePeriod.Name</strong> &mdash; @Model.ActivePeriod.Semester.DisplayName<br />
        <small>
            @Model.ActivePeriod.StartDate.ToString("MMMM dd") to @Model.ActivePeriod.EndDate.ToString("MMMM dd, yyyy")
            &middot; Current stage: <strong>@Model.ActivePeriod.StageName</strong>
        </small>
    </div>

    @* AAS-03: this evaluator's stage is not open yet *@
    @if (!string.IsNullOrEmpty(Model.StageMessage))
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h6 class="text-muted">Nothing to evaluate right now</h6>
                <p class="text-muted mb-0">@Model.StageMessage</p>
            </div>
        </div>
    }
    else if (Model.IsGrouped)
    {
        @* DN-01: Program Chairs organised per program *@
        @if (!string.IsNullOrEmpty(Model.RosterDescription))
        {
            <p class="text-muted small">@Model.RosterDescription</p>
        }

        @foreach (var group in Model.Groups)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        @group.GroupName
                        @if (!string.IsNullOrEmpty(group.GroupSubtitle))
                        {
                            <span class="badge bg-secondary ms-2">@group.GroupSubtitle</span>
                        }
                    </span>
                    <small class="text-muted">
                        @group.Members.Count(m => m.AlreadyEvaluated) of @group.Members.Count completed
                    </small>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in group.Members)
                            {
                                <partial name="_EvaluationRosterRow" model="@(m, Model.ActivePeriod.Id)" />
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card">
            <div class="card-header">
                @(isStudent ? "Faculty to Evaluate" : "Faculty to Evaluate")
                @if (!string.IsNullOrEmpty(Model.RosterDescription))
                {
                    <br /><small class="text-muted fw-normal">@Model.RosterDescription</small>
                }
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Faculty Name</th>
                            @if (isStudent)
                            {
                                <th>Course</th>
                                <th>Section</th>
                            }
                            else
                            {
                                <th>Courses in your program</th>
                            }
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FacultyList)
                        {
                            <tr>
                                <td>
                                    @f.FacultyName
                                    @* PC-01: flag faculty whose home department is elsewhere *@
                                    @if (f.IsFromAnotherDepartment && !string.IsNullOrEmpty(f.HomeDepartment))
                                    {
                                        <br />
                                        <small class="text-muted">
                                            <span class="badge bg-light text-dark border">@f.HomeDepartment</span>
                                            teaches in your program
                                        </small>
                                    }
                                </td>
                                @if (isStudent)
                                {
                                    <td>@(f.CourseCode is null ? "General" : string.IsNullOrWhiteSpace(f.CourseTitle) || f.CourseTitle == f.CourseCode ? f.CourseCode : $"{f.CourseCode} - {f.CourseTitle}")</td>
                                    <td>@(f.Section ?? "-")</td>
                                }
                                else
                                {
                                    <td>
                                        @if (f.CoursesInProgram.Any())
                                        {
                                            <small>@string.Join(", ", f.CoursesInProgram)</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">&mdash;</small>
                                        }
                                    </td>
                                }
                                <td>
                                    @if (f.AlreadyEvaluated)
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!f.AlreadyEvaluated)
                                    {
                                        <a asp-action="Evaluate"
                                           asp-route-facultyId="@f.FacultyId"
                                           asp-route-periodId="@Model.ActivePeriod.Id"
                                           asp-route-subjectId="@f.FacultySubjectId"
                                           class="btn btn-primary btn-sm">Evaluate</a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm btn-view-rating"
                                                data-eval-id="@f.EvaluationId">View My Rating</button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.FacultyList.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">@(isStudent && Model.InstructorChoices.Any() ? "Choose your instructor below to start evaluating" : "No faculty assigned for evaluation")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Course Codes on the Registrar's masterlist taught by more than one faculty member *@
        @if (isStudent && Model.InstructorChoices.Any())
        {
            <div class="card mt-3">
                <div class="card-header">
                    Confirm your instructor
                    <br /><small class="text-muted fw-normal">
                        These courses from your enrollment record are taught by more than one faculty member.
                        Choose the one who teaches your class, then evaluate them.
                    </small>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0 align-middle">
                        <thead><tr><th style="width:25%;">Course Code</th><th>Your instructor</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.InstructorChoices)
                            {
                                <tr>
                                    <td><strong>@c.CourseCode</strong></td>
                                    <td>
                                        <form asp-action="ChooseInstructor" method="post" class="d-flex gap-2">
                                            <select name="facultySubjectId" class="form-select form-select-sm" required>
                                                <option value="">Choose instructor&hellip;</option>
                                                @foreach (var o in c.Options)
                                                {
                                                    <option value="@o.FacultySubjectId">@o.FacultyName@(o.College is not null ? $" ({o.College})" : "")</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap">Confirm</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (isStudent && Model.CoursesWithoutInstructor.Any())
        {
            <p class="small text-muted mt-3">
                No instructor is on record yet for: @string.Join(", ", Model.CoursesWithoutInstructor).
                These will appear here once Academic Affairs records who teaches them.
            </p>
        }
    }

    <!-- My Rating Modal -->
    <div class="modal fade" id="ratingModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">My Evaluation Rating</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6 id="ratingFacultyName" class="mb-3"></h6>
                    <div class="card bg-light mb-3">
                        <div class="card-body text-center">
                            <p class="mb-1 text-muted">Computed Rating</p>
                            <h2 id="ratingOverall" style="color:#1a5632;">&mdash;</h2>
                            <span id="ratingDesc" class="badge"></span>
                            <p class="text-muted small mt-1 mb-0">Formula: (Total Score / 75) &times; 100</p>
                        </div>
                    </div>
                    <div id="ratingBreakdown"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    document.querySelectorAll('.btn-view-rating').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var evalId = this.getAttribute('data-eval-id');
            fetch('@Url.Action("MyRating")' + '?evaluationId=' + evalId)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    document.getElementById('ratingFacultyName').textContent = data.facultyName;
                    document.getElementById('ratingOverall').textContent = data.rating.toFixed(2) + '%';

                    var descEl = document.getElementById('ratingDesc');
                    descEl.textContent = data.description;
                    descEl.className = 'badge bg-success';

                    var html = '<table class="table table-sm mb-0"><thead><tr><th>Category</th><th class="text-center">Average</th></tr></thead><tbody>';
                    data.categories.forEach(function (c) {
                        html += '<tr><td>' + c.name + '</td><td class="text-center"><strong>' + c.average.toFixed(2) + '</strong></td></tr>';
                    });
                    html += '</tbody></table>';
                    document.getElementById('ratingBreakdown').innerHTML = html;

                    var modal = new bootstrap.Modal(document.getElementById('ratingModal'));
                    modal.show();
                });
        });
    });
</script>
}
