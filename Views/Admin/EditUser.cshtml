@model FacultyEvalSystem.ViewModels.EditUserViewModel
@{ ViewData["Title"] = "Edit User"; }

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">Edit User</div>
            <div class="card-body">
                <form asp-action="EditUser" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MiddleName" class="form-label"></label>
                            <input asp-for="MiddleName" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Suffix" class="form-label"></label>
                            <input asp-for="Suffix" class="form-control" placeholder="e.g. Jr." />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <small class="text-muted">The e-mail is what the user signs in with.</small>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" asp-items="(SelectList)ViewBag.Roles" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdNumber" class="form-label"></label>
                            <input asp-for="IdNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CollegeId" class="form-label"></label>
                            <select asp-for="CollegeId" asp-items="(SelectList)ViewBag.Colleges" class="form-select">
                                <option value="">None</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ProgramId" class="form-label"></label>
                            <select asp-for="ProgramId" asp-items="(SelectList)ViewBag.Programs" class="form-select">
                                <option value="">None</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Password</div>
            <div class="card-body d-flex justify-content-between align-items-center gap-3">
                <small class="text-muted">
                    @if (Model.MustChangePassword)
                    {
                        <text>This user is still on the default password and will be asked to change it on their next login.</text>
                    }
                    else
                    {
                        <text>Resetting sets the password back to the system's default password. The user must change it on their next login.</text>
                    }
                </small>
                <form asp-action="ResetPassword" method="post" class="flex-shrink-0"
                      onsubmit="return confirm('Reset this user\'s password to the default password?');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>
