@using FacultyEvalSystem.Models
@model List<FacultyEvalSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var userRoles = (Dictionary<string, string>)ViewBag.UserRoles;
    var roles = (List<string>)ViewBag.Roles;
    string? search = ViewBag.Search;
    string? role = ViewBag.Role;
    int? collegeId = ViewBag.CollegeId;
    int page = ViewBag.Page;
    int total = ViewBag.Total;
    int pageSize = ViewBag.PageSize;
    int pages = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
    bool filtered = !string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(role) || collegeId.HasValue;
}

@* Accounts come from the two imports; Add User covers one-off accounts *@
<div class="d-flex justify-content-end gap-2 mb-3">
    <a asp-controller="BatchImport" asp-action="Index" asp-fragment="registrar" class="btn btn-outline-success btn-sm">Import Student</a>
    <a asp-controller="BatchImport" asp-action="Index" asp-fragment="workload" class="btn btn-outline-primary btn-sm">Import Faculty</a>
    <a asp-action="CreateUser" class="btn btn-primary btn-sm">+ Add User</a>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        @* Results update as you type or change a filter; the button still works without JavaScript *@
        <form method="get" class="row g-2 align-items-end" id="userFilter">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Search</label>
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Name, e-mail, ID number, college or program code" autocomplete="off" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Role</label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">All roles</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(r == role)">@RoleNames.Display(r)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">College</label>
                <select name="collegeId" asp-items="(SelectList)ViewBag.CollegeList" class="form-select form-select-sm">
                    <option value="">All colleges</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary btn-sm">Filter</button>
                <a asp-action="Users" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<div id="userResults">
<p class="text-muted small mb-2">
    @total user@(total == 1 ? "" : "s") @(filtered ? "match" : "in total"), sorted alphabetically.
    @if (pages > 1)
    {
        <text>Showing @((page - 1) * pageSize + 1)&ndash;@Math.Min(page * pageSize, total).</text>
    }
</p>

<div class="card">
    <div class="card-body p-0">
        @* Paged on the server, so the automatic table pager is switched off *@
        <table class="table table-hover mb-0" data-no-paginate>
            <thead>
                <tr><th>Name</th><th>Email</th><th>Role</th><th>College</th><th>Program</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.SortName@(string.IsNullOrWhiteSpace(user.Suffix) ? "" : $" {user.Suffix}")</td>
                        <td><small>@user.Email</small></td>
                        <td><span class="badge bg-secondary">@RoleNames.Display(userRoles.GetValueOrDefault(user.Id))</span></td>
                        <td>@(user.College?.Code ?? "-")</td>
                        <td>
                            @(user.Program?.Code ?? "-")
                            @if (!string.IsNullOrWhiteSpace(user.Section))
                            {
                                <small class="text-muted">&middot; @user.Section</small>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                            <form asp-action="ToggleUser" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    @(user.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">No users found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (pages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center flex-wrap">
            <li class="page-item @(page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Users" asp-route-search="@search" asp-route-role="@role" asp-route-collegeId="@collegeId" asp-route-page="@(page - 1)">Previous</a>
            </li>
            @for (int p = Math.Max(1, page - 4); p <= Math.Min(pages, page + 4); p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" asp-action="Users" asp-route-search="@search" asp-route-role="@role" asp-route-collegeId="@collegeId" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(page == pages ? "disabled" : "")">
                <a class="page-link" asp-action="Users" asp-route-search="@search" asp-route-role="@role" asp-route-collegeId="@collegeId" asp-route-page="@(page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
</div>

@section Scripts {
<script>
    // Real-time search: re-runs the same GET request as the form while the admin
    // types, and swaps in the new results without reloading the page.
    (function () {
        var form = document.getElementById('userFilter');
        var results = document.getElementById('userResults');
        var timer, controller;

        function refresh() {
            var url = form.action.split('?')[0] + '?' + new URLSearchParams(new FormData(form)).toString();
            if (controller) controller.abort();
            controller = new AbortController();
            results.style.opacity = '0.5';

            fetch(url, { signal: controller.signal, headers: { 'X-Requested-With': 'fetch' } })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    var fresh = doc.getElementById('userResults');
                    if (fresh) results.innerHTML = fresh.innerHTML;
                    history.replaceState(null, '', url);
                })
                .catch(function (e) { if (e.name !== 'AbortError') form.submit(); })
                .finally(function () { results.style.opacity = ''; });
        }

        form.querySelector('[name=search]').addEventListener('input', function () {
            clearTimeout(timer);
            timer = setTimeout(refresh, 300);
        });
        form.querySelectorAll('select').forEach(function (sel) { sel.addEventListener('change', refresh); });
        form.addEventListener('submit', function (e) { e.preventDefault(); clearTimeout(timer); refresh(); });
    })();
</script>
}
