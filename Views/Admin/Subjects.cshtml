@model List<FacultyEvalSystem.Models.FacultySubject>
@{ ViewData["Title"] = "Course Assignments"; }

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header">Assign Course to Faculty</div>
            <div class="card-body">
                @if (ViewBag.ActiveSemester is null)
                {
                    <div class="alert alert-warning mb-0">No active semester. Please create one first.</div>
                }
                else
                {
                    <p class="text-muted mb-3">Semester: <strong>@ViewBag.ActiveSemester.DisplayName</strong></p>
                    <form asp-action="CreateSubject" method="post">
                        <div class="mb-3">
                            <label class="form-label">Faculty</label>
                            <select name="facultyId" asp-items="(SelectList)ViewBag.Faculty" class="form-select" required>
                                <option value="">Choose faculty&hellip;</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Course Code</label>
                            <input name="courseCode" class="form-control" placeholder="e.g. IT 101" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Course Title <small class="text-muted">(optional)</small></label>
                            <input name="courseTitle" class="form-control" placeholder="e.g. Introduction to Computing" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Section</label>
                            <input name="section" class="form-control" placeholder="e.g. BSIT 1A" />
                        </div>
                        @* SUP-02: the owning program decides which Program Chair evaluates
                           the faculty teaching this course (PC-01). *@
                        <div class="mb-3">
                            <label class="form-label">
                                Owning Program
                                <small class="text-muted">&mdash; whose Chair evaluates this course</small>
                            </label>
                            <select name="programId" asp-items="(SelectList)ViewBag.Programs" class="form-select" required>
                                <option value="">Choose program&hellip;</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Assign Course</button>
                    </form>
                }
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">Current Semester Assignments (@Model.Count)</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Faculty</th><th>Course</th><th>Section</th><th>Program</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.Faculty.SortName</td>
                                <td>@s.CourseDisplay</td>
                                <td>@(s.Section ?? "-")</td>
                                <td>
                                    @if (s.Program is not null)
                                    {
                                        <span class="badge bg-secondary">@s.Program.Code</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark" title="No Program Chair can evaluate this course until a program is set">Not set</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Enrollments" asp-route-subjectId="@s.Id" class="btn btn-outline-primary btn-sm">
                                        Enrollments
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No assignments yet</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
