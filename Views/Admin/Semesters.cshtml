@model List<FacultyEvalSystem.Models.Semester>
@{
    ViewData["Title"] = "Semester Management";
    // Kept when a semester is rejected, so the Administrator can correct it
    var enteredYear = TempData["AcademicYear"] as string;
    var enteredTerm = TempData["Term"] as string;
}

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header">Add Semester</div>
            <div class="card-body">
                <form asp-action="CreateSemester" method="post">
                    <div class="mb-3">
                        <label class="form-label">Academic Year</label>
                        <input name="academicYear" value="@enteredYear" class="form-control" placeholder="e.g. 2026-2027" required
                               pattern="\d{4}\s*-\s*\d{4}" title="Two years one year apart, e.g. 2026-2027" />
                        <small class="text-muted">One-year cycle: the second year must follow the first, e.g. 2026-2027.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Term</label>
                        <select name="term" class="form-select" required>
                            @foreach (var t in FacultyEvalSystem.Models.Semester.Terms)
                            {
                                <option value="@t" selected="@(t == enteredTerm)">@t</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Create & Set Active</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">Semesters (@Model.Count)</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead><tr><th>Semester</th><th>Status</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.DisplayName</td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!s.IsActive)
                                    {
                                        <form asp-action="SetActiveSemester" method="post" class="d-inline"
                                              onsubmit="return confirm('Make @s.DisplayName the active semester?');">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm">Set Active</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
