@using FacultyEvalSystem.Models
@model List<EvaluationPeriod>
@{
    ViewData["Title"] = "Evaluation Schedule";
    var progress = ViewBag.Progress as Dictionary<int, FacultyEvalSystem.Controllers.AdminController.StageProgress>
                   ?? new Dictionary<int, FacultyEvalSystem.Controllers.AdminController.StageProgress>();
    var reopenableId = ViewBag.ReopenableId as int?;

    string StageBadge(EvaluationStage s) => s switch
    {
        EvaluationStage.NotStarted => "bg-secondary",
        EvaluationStage.StudentEvaluation => "bg-primary",
        EvaluationStage.SupervisorEvaluation => "bg-info text-dark",
        EvaluationStage.Closed => "bg-dark",
        _ => "bg-secondary"
    };
}

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">Create Evaluation Period</div>
            <div class="card-body">
                <form asp-action="CreatePeriod" method="post">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="name" class="form-control" placeholder="e.g. Midterm Evaluation" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Semester</label>
                        <select name="semesterId" asp-items="(SelectList)ViewBag.Semesters" class="form-select" required></select>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Start Date</label>
                            <input name="startDate" type="date" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="form-label">End Date</label>
                            <input name="endDate" type="date" class="form-control" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Create Period</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">How the stages work</div>
            <div class="card-body" style="font-size:13px;">
                <p class="text-muted mb-2">
                    An evaluation period runs one stage at a time. You decide when each stage begins.
                </p>
                <ol class="ps-3 mb-2">
                    <li><strong>Student Evaluation</strong> — students evaluate the faculty who teach them.</li>
                    <li><strong>Supervisor Evaluation</strong> — Program Chairs evaluate faculty teaching in their program,
                        and Deans evaluate their Program Chairs, at the same time.</li>
                    <li><strong>Closed</strong> — no further submissions; results are computed automatically.</li>
                </ol>
                <p class="text-muted mb-2">
                    Opening a stage closes the one before it.
                </p>
                <p class="text-muted mb-0">
                    If some students or supervisors did not finish, a closed period can be
                    <strong>reopened</strong> at any of the three stages. It then moves through the
                    remaining stages as usual, and the results are recomputed when it is closed again.
                    Use <strong>Edit</strong> to extend the end date.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Evaluation Periods</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Semester</th>
                            <th>Current Stage</th>
                            <th>Submitted</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No evaluation periods yet.</td></tr>
                        }
                        @foreach (var p in Model)
                        {
                            var prog = progress.TryGetValue(p.Id, out var pr) ? pr : null;
                            <tr>
                                <td>
                                    <strong>@p.Name</strong><br />
                                    <small class="text-muted">@p.StartDate.ToString("MMM dd") &ndash; @p.EndDate.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td><small>@p.Semester.DisplayName</small></td>
                                <td>
                                    <span class="badge @StageBadge(p.Stage)">@p.StageName</span>
                                    @if (p.Stage == EvaluationStage.StudentEvaluation && p.StudentStageOpenedAt.HasValue)
                                    {
                                        <br /><small class="text-muted">since @p.StudentStageOpenedAt.Value.ToString("MMM dd")</small>
                                    }
                                    else if (p.Stage == EvaluationStage.SupervisorEvaluation && p.SupervisorStageOpenedAt.HasValue)
                                    {
                                        <br /><small class="text-muted">since @p.SupervisorStageOpenedAt.Value.ToString("MMM dd")</small>
                                    }
                                    else if (p.IsClosed && p.ClosedAt.HasValue)
                                    {
                                        <br /><small class="text-muted">on @p.ClosedAt.Value.ToString("MMM dd")</small>
                                    }
                                </td>
                                <td>
                                    @if (prog is not null && p.IsClosed && prog.Expected > 0)
                                    {
                                        <span>@prog.Submitted</span><span class="text-muted"> / @prog.Expected</span>
                                        <br /><small class="text-muted">student evaluations</small>
                                    }
                                    else if (prog is not null && p.IsActive)
                                    {
                                        <span>@prog.Submitted</span>
                                        @if (prog.Expected > 0)
                                        {
                                            <span class="text-muted"> / @prog.Expected</span>
                                            var pct = prog.Expected > 0 ? (int)Math.Round(100.0 * prog.Submitted / prog.Expected) : 0;
                                            <div class="progress mt-1" style="height:5px; width:90px;">
                                                <div class="progress-bar bg-success" style="width:@(Math.Min(pct, 100))%"></div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditPeriod" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    @if (p.NextStage is not null)
                                    {
                                        var next = p.NextStage.Value;
                                        var isClosing = next == EvaluationStage.Closed;
                                        <form asp-action="AdvancePeriodStage" method="post" style="display:inline;"
                                              onsubmit="return confirm('@(isClosing ? "Close this evaluation period? Results will be computed and no further submissions will be accepted." : $"Open the {EvaluationPeriod.StageLabel(next)} stage? The current stage will close.")');">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm @(isClosing ? "btn-danger" : "btn-success")">
                                                @(isClosing ? "Close Period" : $"Open {EvaluationPeriod.StageLabel(next)}")
                                            </button>
                                        </form>
                                    }
                                    else if (p.Id == reopenableId)
                                    {
                                        <form asp-action="ReopenPeriod" method="post" class="d-inline-flex gap-1 align-items-center mt-1"
                                              onsubmit="return confirm('Reopen this evaluation period? Evaluators who have not finished will be able to submit again.');">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <select name="stage" class="form-select form-select-sm" style="width:auto;" aria-label="Stage to reopen">
                                                <option value="@((int)EvaluationStage.StudentEvaluation)">Students</option>
                                                <option value="@((int)EvaluationStage.SupervisorEvaluation)">Program Chairs, Deans &amp; CDI</option>
                                            </select>
                                            <input name="endDate" type="date" class="form-control form-control-sm" style="width:auto;"
                                                   title="New end date (optional)" aria-label="New end date (optional)" />
                                            <button type="submit" class="btn btn-sm btn-warning">Reopen</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small ms-1">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
