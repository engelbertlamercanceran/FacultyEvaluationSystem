@model List<FacultyEvalSystem.Models.StudentEnrollment>
@{
    var subject = (FacultyEvalSystem.Models.FacultySubject)ViewBag.Subject;
    ViewData["Title"] = $"Enrollments - {subject.SubjectCode}";
}

<a asp-action="Subjects" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to Subjects</a>

<div class="card mb-3">
    <div class="card-body">
        <strong>@subject.SubjectCode - @subject.SubjectName</strong> (@(subject.Section ?? "No Section"))<br/>
        <small class="text-muted">Faculty: @subject.Faculty.FullName</small>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header">Enroll Student</div>
            <div class="card-body">
                <div class="mb-3">
                    <input type="text" id="studentSearch" class="form-control" placeholder="Search by name or student number..." autocomplete="off" />
                    <small class="text-muted">Type at least 2 characters</small>
                </div>
                <div id="searchResults"></div>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Enrolled Students (@Model.Count)</span>
                <form method="get" class="d-flex gap-1">
                    <input type="hidden" name="subjectId" value="@subject.Id" />
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search..." style="width:180px;" />
                    <button type="submit" class="btn btn-outline-primary btn-sm">Search</button>
                    @if (ViewBag.Search != null)
                    {
                        <a asp-action="Enrollments" asp-route-subjectId="@subject.Id" class="btn btn-outline-secondary btn-sm">Clear</a>
                    }
                </form>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead><tr><th>#</th><th>Student Name</th><th>Student Number</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@Model[i].Student.FullName</td>
                                <td>@(Model[i].Student.StudentNumber ?? "-")</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">@(ViewBag.Search != null ? "No matching students" : "No students enrolled")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var input = document.getElementById('studentSearch');
        var results = document.getElementById('searchResults');
        var subjectId = @subject.Id;
        var timer;

        input.addEventListener('input', function () {
            clearTimeout(timer);
            var term = this.value.trim();
            if (term.length < 2) { results.innerHTML = ''; return; }

            timer = setTimeout(function () {
                fetch('@Url.Action("SearchStudents")?subjectId=' + subjectId + '&term=' + encodeURIComponent(term))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.length === 0) {
                            results.innerHTML = '<p class="text-muted small">No students found</p>';
                            return;
                        }
                        var html = '<div class="list-group">';
                        data.forEach(function (s) {
                            html += '<div class="list-group-item d-flex justify-content-between align-items-center">' +
                                '<div><strong>' + s.name + '</strong><br/><small class="text-muted">' + (s.studentNumber || '-') + '</small></div>' +
                                '<form method="post" action="@Url.Action("EnrollStudent")">' +
                                '@Html.AntiForgeryToken()' +
                                '<input type="hidden" name="subjectId" value="' + subjectId + '"/>' +
                                '<input type="hidden" name="studentId" value="' + s.id + '"/>' +
                                '<button type="submit" class="btn btn-primary btn-sm">Enroll</button>' +
                                '</form></div>';
                        });
                        html += '</div>';
                        results.innerHTML = html;
                    });
            }, 300);
        });
    })();
</script>
}
