@model FacultyEvalSystem.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Create User"; }

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Create New User</div>
            <div class="card-body">
                <form asp-action="CreateUser" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" placeholder="Leave blank for first-login setup" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted">If no password is provided, the user will be prompted to set their password on first login.</small>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" asp-items="(SelectList)ViewBag.Roles" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdNumber" class="form-label"></label>
                            <input asp-for="IdNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CollegeId" class="form-label"></label>
                            <select asp-for="CollegeId" asp-items="(SelectList)ViewBag.Colleges" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ProgramId" class="form-label"></label>
                            <select asp-for="ProgramId" asp-items="(SelectList)ViewBag.Programs" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
