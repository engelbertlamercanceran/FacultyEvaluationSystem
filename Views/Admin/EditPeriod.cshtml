@using FacultyEvalSystem.Models
@model EvaluationPeriod
@{ ViewData["Title"] = "Edit Evaluation Period"; }

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Edit / Extend Evaluation Period</div>
            <div class="card-body">
                <p class="small text-muted mb-3">
                    @Model.Semester.DisplayName &middot; current stage: <strong>@Model.StageName</strong>
                </p>
                <form asp-action="EditPeriod" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="name" value="@Model.Name" class="form-control" required />
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Start Date</label>
                            <input name="startDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="form-label">End Date</label>
                            <input name="endDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                    </div>
                    <p class="small text-muted">
                        To extend the evaluation, move the end date later. The stages are still opened
                        and closed from the Evaluation Schedule page.
                    </p>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Periods" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
