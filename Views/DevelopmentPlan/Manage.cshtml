@using FacultyEvalSystem.Models
@model List<EvaluationResult>
@{
    ViewData["Title"] = "Development Plans";
    var periods = (List<EvaluationPeriod>)ViewBag.Periods;
    var selectedPeriodId = (int?)ViewBag.SelectedPeriodId;
    var plans = (Dictionary<string, DevelopmentPlan>)ViewBag.Plans;

    var isDean = User.IsInRole("Dean");
    var isAa = User.IsInRole("AA");
    var rosterLabel = isDean
        ? "Program Chairs under your college"
        : isAa
            ? "Program Chairs with no designated evaluator"
            : "Faculty teaching in your program";
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get">
            <label class="form-label">Evaluation Period</label>
            <select name="periodId" class="form-select" onchange="this.form.submit()">
                @foreach (var p in periods)
                {
                    <option value="@p.Id" selected="@(p.Id == selectedPeriodId)">@p.DisplayName</option>
                }
            </select>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-header">@rosterLabel (@Model.Count)</div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Department</th>
                        <th class="text-center">SET Rating</th>
                        <th class="text-center">SEF Rating</th>
                        <th class="text-center">FEDAF Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var plan = plans.GetValueOrDefault(r.FacultyId);
                        var status = plan?.Status ?? FedafStatus.Draft;
                        <tr>
                            <td>@r.Faculty.FullName</td>
                            <td><small class="text-muted">@(r.Faculty.Program?.Code ?? r.Faculty.College?.Code ?? "—")</small></td>
                            <td class="text-center"><strong>@r.StudentRating.ToString("F2")</strong></td>
                            <td class="text-center"><strong>@r.SupervisorRating.ToString("F2")</strong></td>
                            <td class="text-center">
                                <span class="badge @DevelopmentPlan.StatusBadgeClass(status)">@DevelopmentPlan.StatusLabel(status)</span>
                                @if (plan?.AcknowledgedAt != null)
                                {
                                    <br /><small class="text-muted">@plan.AcknowledgedAt.Value.ToString("MMM dd, yyyy")</small>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Review" asp-route-periodId="@r.EvaluationPeriodId" asp-route-facultyId="@r.FacultyId"
                                   class="btn btn-outline-primary btn-sm">
                                    @(status == FedafStatus.Draft ? "Enter Development Plan" : "Review & Plan")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        No evaluation results found for this period among @rosterLabel.ToLower().
    </div>
}
