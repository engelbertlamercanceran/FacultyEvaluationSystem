@using FacultyEvalSystem.Models
@model List<FacultyEvalSystem.Controllers.DevelopmentPlanController.RosterRow>
@{
    ViewData["Title"] = "Development Plans";
    var periods = (List<EvaluationPeriod>)ViewBag.Periods;
    var selectedPeriodId = (int?)ViewBag.SelectedPeriodId;

    var isDean = User.IsInRole("Dean");
    var isAa = User.IsInRole("AA") || User.IsInRole("AAStaff");
    var rosterLabel = isDean
        ? "Faculty and Program Chairs under your college"
        : isAa
            ? "Program Chairs with no designated evaluator"
            : "Faculty in your program";
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Evaluation Period</label>
                <select name="periodId" class="form-select" onchange="this.form.submit()">
                    @foreach (var p in periods)
                    {
                        <option value="@p.Id" selected="@(p.Id == selectedPeriodId)">@p.DisplayName</option>
                    }
                </select>
            </div>
        </form>
        <p class="small text-muted mt-3 mb-0">
            @if (isDean)
            {
                <text>Creating a Development Plan notifies the faculty member and their Program Chair.
                The faculty member may edit and acknowledge it; the Program Chair then finalizes it.</text>
            }
            else
            {
                <text>Creating a Development Plan notifies the faculty member. After they acknowledge it you
                will be notified, and you can review it and click <strong>Finalize</strong> to lock it.</text>
            }
        </p>
    </div>
</div>

@if (periods.Count == 0)
{
    <div class="alert alert-info">No evaluation periods have been created yet.</div>
}
else if (Model.Any())
{
    <div class="card">
        <div class="card-header">@rosterLabel (@Model.Count)</div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Program</th>
                        <th class="text-center">SET Rating</th>
                        <th class="text-center">SEF Rating</th>
                        <th class="text-center">Development Plan</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var plan = row.Plan;
                        var status = plan?.Status ?? FedafStatus.Draft;
                        <tr>
                            <td>@row.Faculty.SortName</td>
                            <td><small class="text-muted">@(row.Faculty.Program?.Code ?? row.Faculty.College?.Code ?? "—")</small></td>
                            <td class="text-center">@(row.Result is not null ? row.Result.StudentRating.ToString("F2") : "—")</td>
                            <td class="text-center">@(row.Result is not null ? row.Result.SupervisorRating.ToString("F2") : "—")</td>
                            <td class="text-center">
                                <span class="badge @DevelopmentPlan.StatusBadgeClass(status)">@DevelopmentPlan.StatusLabel(status)</span>
                                @if (plan?.AcknowledgedAt != null)
                                {
                                    <br /><small class="text-muted">Acknowledged @plan.AcknowledgedAt.Value.ToString("MMM dd, yyyy")</small>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Review" asp-route-periodId="@selectedPeriodId" asp-route-facultyId="@row.Faculty.Id"
                                   class="btn btn-sm @(status == FedafStatus.Acknowledged ? "btn-warning" : "btn-outline-primary")">
                                    @(status switch
                                    {
                                        FedafStatus.Draft => "Create Development Plan",
                                        FedafStatus.Acknowledged => "Review & Finalize",
                                        FedafStatus.Finalized => "View",
                                        _ => "View / Edit"
                                    })
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        There is nobody in your list for this period (@rosterLabel.ToLower()).
    </div>
}
