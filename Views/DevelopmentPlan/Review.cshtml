@using FacultyEvalSystem.Models
@model DevelopmentPlan
@{
    var result = ViewBag.Result as EvaluationResult;
    var faculty = (ApplicationUser)ViewBag.Faculty;
    var period = (EvaluationPeriod)ViewBag.Period;
    var canEdit = (bool)ViewBag.CanEdit;
    var canFinalize = (bool)ViewBag.CanFinalize;
    var finalizer = ViewBag.Finalizer as string;
    var createdBy = ViewBag.CreatedBy as string;
    var isNew = Model.Id == 0;
    ViewData["Title"] = $"Development Plan — {faculty.FullName}";
}

<a asp-action="Manage" asp-route-periodId="@period.Id" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back</a>

<div class="card mb-3">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-6">
                <strong>@faculty.FullName</strong><br />
                <small class="text-muted">
                    @(faculty.Program?.Name ?? "No program set") &middot; @(faculty.College?.Name ?? "No college set")
                </small>
            </div>
            <div class="col-md-6 text-end">
                <strong>@period.Semester.DisplayName</strong><br />
                @if (result is not null)
                {
                    <strong class="ms-2">SET: @result.StudentRating.ToString("F2")</strong>
                    <strong class="ms-2">SEF: @result.SupervisorRating.ToString("F2")</strong>
                }
                else
                {
                    <small class="text-muted">Evaluation results not yet computed for this period</small>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <small class="text-muted">Status</small><br />
            <span class="badge @DevelopmentPlan.StatusBadgeClass(Model.Status)">@Model.StatusName</span>
            @if (createdBy is not null)
            {
                <small class="text-muted ms-2">Created by @createdBy (@(Model.CreatedByRole == "ProgramChair" ? "Program Chair" : Model.CreatedByRole))</small>
            }
            @if (Model.IsAcknowledged)
            {
                <small class="text-muted ms-2">&middot; acknowledged @Model.AcknowledgedAt!.Value.ToString("MMMM dd, yyyy")</small>
            }
            @if (Model.IsFinalized)
            {
                <small class="text-muted ms-2">&middot; finalized @Model.FinalizedAt!.Value.ToString("MMMM dd, yyyy")</small>
            }
        </div>
        @if (result is not null)
        {
            <div>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        onclick="showPreview('@Url.Action("IFER", "Reports", new { periodId = period.Id, facultyId = faculty.Id, preview = true })', 'IFER')">
                    Preview IFER
                </button>
                <button type="button" class="btn btn-outline-info btn-sm"
                        onclick="showPreview('@Url.Action("FEDAF", "Reports", new { periodId = period.Id, facultyId = faculty.Id, preview = true })', 'FEDAF')">
                    Preview FEDAF
                </button>
            </div>
        }
    </div>
</div>

@* Workflow guidance *@
@if (Model.IsFinalized)
{
    <div class="alert alert-secondary small py-2">
        This Development Plan has been finalized and is locked. It can only be viewed.
    </div>
}
else if (Model.IsAcknowledged)
{
    <div class="alert @(canFinalize ? "alert-warning" : "alert-light border") small py-2">
        The faculty member has acknowledged this plan.
        @if (canFinalize)
        {
            <text>Review it, make any final changes, then click <strong>Finalize</strong> to lock it.</text>
        }
        else
        {
            <text>It is waiting to be finalized by @(finalizer ?? "the Program Chair").</text>
        }
    </div>
}
else if (!isNew)
{
    <div class="alert alert-light border small py-2">
        Waiting for the faculty member to review and acknowledge this plan. They may edit it before acknowledging.
    </div>
}

<div class="card">
    <div class="card-header">
        Development Plan (to be jointly accomplished by the Supervisor and Faculty)
    </div>
    <div class="card-body">
        @if (!canEdit)
        {
            <div class="mb-3">
                <label class="form-label">Areas for Improvement</label>
                <div class="form-control bg-light" style="min-height:100px; white-space:pre-wrap;">@(Model.AreasForImprovement ?? "Not provided.")</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Proposed Learning and Development Activities</label>
                <div class="form-control bg-light" style="min-height:100px; white-space:pre-wrap;">@(Model.ProposedActivities ?? "Not provided.")</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Action Plan</label>
                <div class="form-control bg-light" style="min-height:100px; white-space:pre-wrap;">@(Model.ActionPlan ?? "Not provided.")</div>
            </div>
        }
        else
        {
            <form asp-action="Review" method="post">
                <input type="hidden" name="evaluationPeriodId" value="@period.Id" />
                <input type="hidden" name="facultyId" value="@faculty.Id" />

                <div class="mb-3">
                    <label class="form-label">Areas for Improvement</label>
                    <textarea name="areasForImprovement" class="form-control" rows="4" maxlength="2000"
                              placeholder="Areas identified from the evaluation results...">@Model.AreasForImprovement</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Proposed Learning and Development Activities</label>
                    <textarea name="proposedActivities" class="form-control" rows="4" maxlength="2000"
                              placeholder="Recommend training, seminars, mentoring programs...">@Model.ProposedActivities</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Action Plan</label>
                    <textarea name="actionPlan" class="form-control" rows="4" maxlength="2000"
                              placeholder="Specific steps, timelines, responsible parties...">@Model.ActionPlan</textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    @(isNew ? "Create Development Plan" : "Save Changes")
                </button>

                @if (Model.SupervisorSubmittedAt != null)
                {
                    <small class="text-muted ms-2">Last saved: @Model.SupervisorSubmittedAt.Value.ToString("MMM dd, yyyy hh:mm tt")</small>
                }
                @if (Model.FacultyEditedAt != null)
                {
                    <small class="text-muted ms-2">&middot; edited by faculty @Model.FacultyEditedAt.Value.ToString("MMM dd, yyyy hh:mm tt")</small>
                }
            </form>

            @if (canFinalize)
            {
                <hr />
                <form asp-action="Finalize" method="post"
                      onsubmit="return confirm('Finalize this Development Plan? It will be locked and can no longer be edited by anyone.');">
                    <input type="hidden" name="evaluationPeriodId" value="@period.Id" />
                    <input type="hidden" name="facultyId" value="@faculty.Id" />
                    <button type="submit" class="btn btn-success">Finalize &amp; Lock</button>
                    <small class="text-muted ms-2">Save any changes first. After finalizing, the plan is view-only.</small>
                </form>
            }
        }
    </div>
</div>

@if (result is not null)
{
    <div class="mt-3">
        <a asp-controller="Reports" asp-action="IFER" asp-route-periodId="@period.Id" asp-route-facultyId="@faculty.Id"
           class="btn btn-outline-secondary btn-sm">Download IFER PDF</a>
        <a asp-controller="Reports" asp-action="FEDAF" asp-route-periodId="@period.Id" asp-route-facultyId="@faculty.Id"
           class="btn btn-outline-info btn-sm">Download FEDAF PDF</a>
    </div>
}

<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="height:90vh;">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="previewTitle">Preview</h6>
                <div class="ms-auto me-2">
                    <span class="badge @DevelopmentPlan.StatusBadgeClass(Model.Status)">@Model.StatusName</span>
                </div>
                <a id="previewDownload" href="#" class="btn btn-sm btn-primary me-2">Download</a>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="previewFrame" src="" style="width:100%; height:100%; border:0;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showPreview(url, label) {
            document.getElementById('previewTitle').textContent = label + ' Preview';
            document.getElementById('previewFrame').src = url;
            document.getElementById('previewDownload').href = url.replace('preview=True', 'preview=False').replace('preview=true', 'preview=false');
            new bootstrap.Modal(document.getElementById('previewModal')).show();
        }
    </script>
}
