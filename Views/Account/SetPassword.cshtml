@model FacultyEvalSystem.ViewModels.SetPasswordViewModel
@{ ViewData["Title"] = "Set Your Password"; Layout = "_Layout"; }

<div class="row justify-content-center" style="min-height:100vh; align-items:center;">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h4 style="color:#1a5632; font-weight:700;">ISU CABAGAN</h4>
                    <p class="text-muted">Faculty Evaluation System</p>
                </div>

                <div class="alert alert-info">
                    <strong>First-time login.</strong> Please set your password to continue.
                </div>

                <form asp-action="SetPassword" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Email" />
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="text" class="form-control" value="@Model.Email" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autofocus />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Set Password & Sign In</button>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-muted">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
        <p class="text-center text-muted mt-3" style="font-size:12px;">
            Isabela State University - Cabagan Campus &copy; @DateTime.Now.Year
        </p>
    </div>
</div>
