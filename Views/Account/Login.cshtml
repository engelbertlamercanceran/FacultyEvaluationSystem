@model FacultyEvalSystem.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Sign In"; Layout = "_Layout"; }

<div class="row justify-content-center" style="min-height:100vh; align-items:center;">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h4 style="color:#1a5632; font-weight:700;">ISU CABAGAN</h4>
                    <p class="text-muted">Faculty Evaluation System</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ShowPassword" />

                    @if (!Model.ShowPassword)
                    {
                        <!-- Step 1: Email only -->
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="email@isuc.edu.ph" autofocus />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">Next</button>
                    }
                    else
                    {
                        <!-- Step 2: Show email (locked) + password -->
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="text" class="form-control bg-light" value="@Model.Email" disabled />
                                <a href="@Url.Action("Login")" class="btn btn-outline-secondary btn-sm text-nowrap">Change</a>
                            </div>
                            <input type="hidden" asp-for="Email" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" autofocus />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">Sign In</button>
                    }
                </form>
            </div>
        </div>
        <p class="text-center text-muted mt-3" style="font-size:12px;">
            Isabela State University - Cabagan Campus &copy; @DateTime.Now.Year
        </p>
    </div>
</div>
