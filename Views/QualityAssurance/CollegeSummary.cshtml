@using FacultyEvalSystem.Models
@using FacultyEvalSystem.Controllers
@model List<QualityAssuranceController.CollegeSummaryGroup>
@{
    ViewData["Title"] = "Summary Results per College";
    var periods = ViewBag.Periods as List<EvaluationPeriod> ?? [];
    var selPeriod = ViewBag.SelectedPeriodId as int?;
}

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small text-muted mb-1">Evaluation Period</label>
                <select name="periodId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var p in periods)
                    {
                        <option value="@p.Id" selected="@(selPeriod == p.Id)">@p.DisplayName</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No results computed for this evaluation period yet.</div>
}
else
{
    <div class="row g-3 mb-3">
        @foreach (var g in Model)
        {
            <div class="col-md-3">
                <div class="stat-card">
                    <p class="mb-1 small text-muted">@g.CollegeCode</p>
                    <h3>@g.AverageSet.ToString("F2")</h3>
                    <p>SET average &middot; @g.FacultyCount faculty</p>
                </div>
            </div>
        }
    </div>

    @foreach (var g in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@g.CollegeName</strong>
                    <span class="badge bg-secondary ms-2">@g.CollegeCode</span>
                </div>
                <div class="text-muted small">
                    SET <strong>@g.AverageSet.ToString("F2")</strong>
                    &nbsp;&middot;&nbsp;
                    SEF <strong>@g.AverageSef.ToString("F2")</strong>
                    &nbsp;&middot;&nbsp;
                    @g.FacultyCount faculty
                    &nbsp;&middot;&nbsp;
                    @g.TotalStudentRespondents student respondents
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Faculty</th>
                            <th>Program</th>
                            <th class="text-center">SET</th>
                            <th class="text-center">Respondents</th>
                            <th class="text-center">SEF</th>
                            <th>Descriptive Rating</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in g.Faculty)
                        {
                            <tr>
                                <td><small>@r.Faculty.FullName</small></td>
                                <td><small class="text-muted">@(r.Faculty.Program?.Code ?? "—")</small></td>
                                <td class="text-center"><strong>@r.StudentRating.ToString("F2")</strong></td>
                                <td class="text-center"><small>@r.StudentRespondents</small></td>
                                <td class="text-center"><strong>@r.SupervisorRating.ToString("F2")</strong></td>
                                <td><small>@r.StudentDescriptiveRating</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
