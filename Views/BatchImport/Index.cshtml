@{
    ViewData["Title"] = "Faculty & Student Import";
    var active = ViewBag.ActiveSemester as FacultyEvalSystem.Models.Semester;
}

<div class="alert alert-light border small">
    Active semester: <strong>@(active?.DisplayName ?? "none")</strong>
    @if (active is not null)
    {
        <text>&middot; @ViewBag.StudentCount students with @ViewBag.StudentCourseCount enrolled Course Codes
        &middot; @ViewBag.AssignmentCount faculty course assignments</text>
    }
</div>

<div class="row g-3 mb-4">
    @* Student Import: the Registrar's masterlist *@
    <div class="col-lg-6" id="registrar">
        <div class="card h-100 border-success">
            <div class="card-header bg-success text-white">
                <strong>Import Student</strong> <small class="opacity-75">— Registrar's Masterlist</small>
            </div>
            <div class="card-body">
                <p class="small mb-2">
                    Upload the Registrar's list of students and their enrolled subjects (<code>.xlsx</code> or <code>.csv</code>)
                    for the active semester. For every row the system:
                </p>
                <ul class="small mb-3">
                    <li>retrieves the <strong>student name</strong> and <strong>enrolled Course Codes</strong>;</li>
                    <li>identifies the student by <strong>Name + Program</strong> &mdash; re-importing updates the same student;</li>
                    <li>creates the account automatically with the default password <code>@ViewBag.DefaultPassword</code>;</li>
                    <li>links each Course Code to the faculty member teaching it. Where several faculty teach the same
                        Course Code, the student confirms their instructor on the evaluation page.</li>
                </ul>
                <p class="text-muted small mb-2">
                    Expected columns (header row): <code>Program Name</code>, <code>Last Name</code>, <code>First Name</code>,
                    <code>Middle Name</code>, <code>Suffix</code>, then <code>Course Code 1</code> (or <code>Subject Code 1</code>),
                    <code>Units</code>, <code>Course Code 2</code>, &hellip;
                </p>
                <form asp-action="ImportRegistrar" method="post" enctype="multipart/form-data">
                    <div class="input-group">
                        <input type="file" name="file" accept=".xlsx,.csv" class="form-control form-control-sm" required />
                        <button type="submit" class="btn btn-success btn-sm"
                                onclick="if (this.form.checkValidity()) { this.disabled = true; this.innerText = 'Importing…'; this.form.submit(); }">
                            Import Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* Uploaded by the Administrator *@
        <div class="col-lg-6" id="workload">
            <div class="card h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <strong>Import Faculty</strong> <small class="opacity-75">— Faculty Workload Summary</small>
                </div>
                <div class="card-body">
                    <p class="small mb-2">
                        Upload the campus Faculty Workload Summary (<code>.xlsx</code>) for the active semester. Faculty are
                        associated with their <strong>College</strong>; Deans and Program Chairs are recognised from the
                        Designation column and linked to their <strong>Program</strong>. Each Course Code taught becomes a
                        course assignment. New accounts use the default password.
                    </p>
                    <form asp-action="ImportWorkload" method="post" enctype="multipart/form-data">
                        <div class="input-group">
                            <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" required />
                            <button type="submit" class="btn btn-primary btn-sm"
                                    onclick="if (this.form.checkValidity()) { this.disabled = true; this.innerText = 'Importing…'; this.form.submit(); }">
                                Import Faculty
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
</div>
