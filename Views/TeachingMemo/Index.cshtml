@using FacultyEvalSystem.Models
@using FacultyEvalSystem.Controllers
@{
    ViewData["Title"] = "Teaching Memo";
    var activeSemester = ViewBag.ActiveSemester as Semester;
    var assignments = ViewBag.Assignments as List<FacultySubject> ?? [];
    var programs = ViewBag.Programs as List<AcademicProgram> ?? [];
    var missingProgram = assignments.Count(a => a.ProgramId is null);
}

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header">Import Teaching Memo</div>
            <div class="card-body">
                @if (activeSemester is null)
                {
                    <div class="alert alert-warning mb-0">
                        No active semester. Please ask the Administrator to create one first.
                    </div>
                }
                else
                {
                    <p class="text-muted mb-3">
                        Semester: <strong>@activeSemester.DisplayName</strong>
                    </p>
                    <form asp-action="Import" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Teaching Memo file (CSV)</label>
                            <input type="file" name="file" accept=".csv" class="form-control" required />
                        </div>
                        <div class="form-check mb-3">
                            <input type="checkbox" name="replaceExisting" value="true"
                                   class="form-check-input" id="replaceExisting" />
                            <label class="form-check-label small" for="replaceExisting">
                                Replace this semester's existing assignments
                                <br />
                                <span class="text-muted">
                                    Assignments that already have evaluations recorded against them
                                    are always kept.
                                </span>
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Import Teaching Memo</button>
                    </form>

                    <hr />
                    <a asp-action="Template" class="btn btn-outline-secondary btn-sm w-100">
                        Download Template
                    </a>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">Expected columns</div>
            <div class="card-body" style="font-size:13px;">
                <code style="font-size:12px;">@string.Join(", ", TeachingMemoController.ExpectedColumns)</code>
                <hr />
                <p class="mb-2">
                    <strong>ProgramCode</strong> is the program that <em>owns</em> the course &mdash;
                    not necessarily the faculty member's own department.
                </p>
                <p class="text-muted mb-0">
                    This is what lets a Program Chair evaluate faculty from other departments who
                    teach courses within their program. Without it, the course will not appear on
                    any Chair's list.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        @if (missingProgram > 0)
        {
            <div class="alert alert-warning py-2">
                <strong>@missingProgram assignment@(missingProgram == 1 ? "" : "s")</strong> have no owning
                program. Faculty teaching @(missingProgram == 1 ? "it" : "them") will not appear on any
                Program Chair's evaluation list until a program is set below.
            </div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Teaching Assignments@(activeSemester is not null ? $" — {activeSemester.DisplayName}" : "")</span>
                <small class="text-muted">@assignments.Count total</small>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Memo</th>
                            <th>Faculty</th>
                            <th>Subject</th>
                            <th>Section</th>
                            <th>Owning Program</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (assignments.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No teaching assignments yet.</td></tr>
                        }
                        @foreach (var a in assignments)
                        {
                            <tr class="@(a.ProgramId is null ? "table-warning" : "")">
                                <td><small class="text-muted">@(a.TeachingMemoNumber ?? "—")</small></td>
                                <td><small>@a.Faculty.FullName</small></td>
                                <td><small>@a.SubjectCode<br /><span class="text-muted">@a.SubjectName</span></small></td>
                                <td><small>@(a.Section ?? "—")</small></td>
                                <td>
                                    <form asp-action="SetProgram" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <select name="programId" class="form-select form-select-sm"
                                                onchange="this.form.submit()" style="min-width:110px;">
                                            <option value="">— not set —</option>
                                            @foreach (var p in programs)
                                            {
                                                <option value="@p.Id" selected="@(a.ProgramId == p.Id)">@p.Code</option>
                                            }
                                        </select>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
