@model List<FacultyEvalSystem.Models.Notification>
@{ ViewData["Title"] = "Notifications"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">
        @Model.Count(n => !n.IsRead) unread &middot; notifications appear here only (no e-mail is sent)
    </p>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Mark all as read</button>
        </form>
    }
</div>

<div class="card">
    <div class="list-group list-group-flush">
        @foreach (var n in Model)
        {
            <a asp-action="Open" asp-route-id="@n.Id"
               class="list-group-item list-group-item-action @(n.IsRead ? "" : "fw-semibold")"
               style="@(n.IsRead ? "" : "border-left:4px solid var(--accent);")">
                <div class="d-flex justify-content-between">
                    <span>@n.Title</span>
                    <small class="text-muted text-nowrap ms-3">@n.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</small>
                </div>
                @if (!string.IsNullOrEmpty(n.Message))
                {
                    <small class="text-muted fw-normal">@n.Message</small>
                }
            </a>
        }
        @if (!Model.Any())
        {
            <div class="list-group-item text-center text-muted py-4">You have no notifications.</div>
        }
    </div>
</div>
